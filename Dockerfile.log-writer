ARG BUILDPLATFORM=linux/amd64
ARG TARGETPLATFORM=linux/amd64
ARG TARGETOS=linux
ARG TARGETARCH=amd64

FROM --platform=${BUILDPLATFORM} swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/golang:1.25-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

ENV GOPROXY=https://goproxy.cn,https://mirrors.aliyun.com/goproxy/,direct \
    GO111MODULE=on \
    CGO_ENABLED=0

WORKDIR /build

COPY go.mod go.sum ./
COPY plugins/kubernetes/go.mod plugins/kubernetes/go.sum ./plugins/kubernetes/
RUN go mod download

COPY . .
RUN GOOS="${TARGETOS}" GOARCH="${TARGETARCH:-$(go env GOARCH)}" \
    go build -trimpath -ldflags="-s -w" -o /out/opshub-log-writer ./cmd/opshub-log-writer

FROM --platform=${TARGETPLATFORM} swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/alpine:3.21

RUN apk --no-cache add ca-certificates tzdata curl && \
    mkdir -p /app/data/log-deadletter

ENV TZ=Asia/Shanghai \
    OPSHUB_LOG_WRITER_HTTP_ADDRESS=:9881 \
    OPSHUB_LOG_WRITER_DEADLETTER_PATH=/app/data/log-deadletter/failed.ndjson

WORKDIR /app
COPY --from=builder /out/opshub-log-writer /app/opshub-log-writer

EXPOSE 9881

ENTRYPOINT ["/app/opshub-log-writer"]
