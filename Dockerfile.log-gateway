ARG BUILDPLATFORM=linux/amd64
ARG TARGETPLATFORM=linux/amd64
ARG TARGETOS=linux
ARG TARGETARCH=amd64

FROM --platform=${BUILDPLATFORM} swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/golang:1.25-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

ENV GOPROXY=https://goproxy.cn,https://mirrors.aliyun.com/goproxy/,direct \
    GO111MODULE=on \
    CGO_ENABLED=0

WORKDIR /build

COPY go.mod go.sum ./
COPY plugins/kubernetes/go.mod plugins/kubernetes/go.sum ./plugins/kubernetes/
RUN go mod download

COPY . .
RUN GOOS="${TARGETOS}" GOARCH="${TARGETARCH:-$(go env GOARCH)}" \
    go build -trimpath -ldflags="-s -w" -o /out/opshub-log-gateway ./cmd/opshub-log-gateway

FROM --platform=${TARGETPLATFORM} swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/alpine:3.21

RUN apk --no-cache add ca-certificates tzdata curl

ENV TZ=Asia/Shanghai \
    OPSHUB_LOG_GATEWAY_HTTP_ADDRESS=:9880 \
    OPSHUB_LOG_GATEWAY_GRPC_ADDRESS=:9882

WORKDIR /app
COPY --from=builder /out/opshub-log-gateway /app/opshub-log-gateway

EXPOSE 9880 9882

ENTRYPOINT ["/app/opshub-log-gateway"]
